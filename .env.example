# CST-MCP configuration template.
#
# EASIEST PATH: run
#
#     python check_install.py --fix
#
# which finds the CST installation on THIS computer and writes .env for you.
#
# If you prefer to edit by hand, copy this file to `.env` and set the two CST
# lines for your machine. Nothing else is required, and no network access is
# needed: the server reads `.env` itself at start-up.
#
# NOTE: the values below are PLACEHOLDERS. Replace every <...> before use, or
# just run the command above.

# --- CST installation --------------------------------------------------------
# The folder that contains AMD64\, Library\, Online Help\ ...
# Example: C:\Program Files\CST Studio Suite 2026
CST_INSTALL_ROOT=<CST install folder>

# The Design Environment executable (usually <CST_INSTALL_ROOT>\AMD64\...)
# Example: C:\Program Files\CST Studio Suite 2026\AMD64\CST DESIGN ENVIRONMENT_AMD64.exe
CST_DESIGN_ENVIRONMENT_EXE=<CST install folder>\AMD64\CST DESIGN ENVIRONMENT_AMD64.exe

# --- working folders ---------------------------------------------------------
# Projects created through the MCP are saved here immediately, so a project is
# never lost in a temporary folder. Use a fast local disk with free space.
# Keep it on the same drive as CST unless you have a reason not to.
CST_MCP_WORKSPACE=<drive>:\CST_MCP_workspace

# Where exported evidence (Touchstone, ASCII, PNG, reports) is written.
CST_MCP_EVIDENCE=<drive>:\CST_MCP_workspace\evidence

# --- optional ----------------------------------------------------------------
# Per-call timeout for the runtime bridge commands, in seconds.
CST_RUNTIME_CLI_TIMEOUT=120

# Set to 1 to keep the CST GUI hidden where the API supports it.
CST_MCP_QUIET=1
